# ==============================================================================
# Spectra Mythos Hive — Environment Configuration
# Copy this file to `.env` and adjust values for your Server or Worker machine.
# ==============================================================================

# --- Connection & Authentication ---
# URL of the Hive Server (use http://127.0.0.1:8000 for local, or host LAN/public IP)
HIVE_URL=http://127.0.0.1:8000

# Shared password between Hive Server and Workers (CHANGE THIS before hosting online!)
HIVE_PASSWORD=change_me_to_a_strong_password

# Display name shown in the Hive Server terminal when your worker submits gradients
WORKER_NAME=Worker-01

# --- Server Options (hive_server.py) ---
HIVE_HOST=0.0.0.0
HIVE_PORT=8000
HIVE_LR=3e-5
HIVE_SAVE_EVERY=10

# --- Worker Hardware & Batch Tuning ---
# MICRO_BATCH controls parallel texts per step and VRAM usage:
#   auto -> picks 1 for <= 8-9 GB GPUs (RTX 4060 ~4.5-5.5 GB VRAM),
#           2 for 10-12 GB GPUs (RTX 3060 12GB / 4070),
#           6 for 14-16+ GB GPUs (RTX 5060 Ti 16GB / 4080 / 4090)
HIVE_MICRO_BATCH=auto

# Gradient accumulation steps per Hive job upload (128 is proven default; 64 uploads more frequently)
HIVE_GRAD_ACCUM=128

# Sequence length (must match the checkpoint architecture; 256 for consumer VRAM)
HIVE_SEQ_LEN=256

# --- Phase 1 Dataset (hive_worker.py) ---
HIVE_DATASET_SUBSET=sample-10BT

# --- Phase 2 SFT / Chat Worker (hive_worker_phase2.py) ---
HIVE_PHASE2_DATASET=tatsu-lab/alpaca
HIVE_SYSTEM_PROMPT=You are a helpful, honest AI companion. Think carefully and converse naturally.
